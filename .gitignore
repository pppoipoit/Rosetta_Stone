*.dSYM

# The Xcode project is GENERATED from project.yml by XcodeGen and is never
# committed: a binary .xcodeproj cannot be reviewed in a diff and would drift
# out of sync with project.yml. Run `xcodegen generate` after cloning.
RosettaStone.xcodeproj/
*.xcworkspace/xcshareddata/IDEWorkspaceChecks.plist

# ==== Swift Package Manager ====
.build/
.swiftpm/
Package.resolved

# ==== Compiled test harness =====
# `swiftc -o macprofile-tests tests/MacProfileTests.swift` drops a binary in the
# working directory. On Windows it also emits an import library and an export
# file next to it. None of these are source.
macprofile-tests
macprofile-tests.*
tests/macprofile-tests*
*.exp
*.lib

